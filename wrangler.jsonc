{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brasilgrid",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "assets": {
    "binding": "ASSETS",
    // Onde "npm run build" (vite build) deixa os arquivos da SPA.
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    // O worker roda primeiro nessas rotas (API e, no futuro, as páginas de
    // resultado /r/:id, que vão precisar injetar meta tags de OG). Qualquer
    // outra rota vai direto para os arquivos estáticos da SPA.
    "run_worker_first": ["/api/*", "/r/*"]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Aponta para o Neon de produção (sa-east-1). Localmente (wrangler dev /
      // npm run dev), o binding usa localConnectionString e ignora esse id.
      //
      // IMPORTANTE: esse config tem caching desligado (foi criado com
      // "wrangler hyperdrive create ... --caching-disabled" e, se precisar
      // recriar, use a mesma flag, ou "wrangler hyperdrive update <id>
      // --caching-disabled"). Sem isso, o Hyperdrive cacheia o SELECT de
      // loadGameState() e o jogador não vê o próprio palpite logo depois de
      // acertar — pareceu um "não aceitou" que na real nunca existiu, o
      // gabarito e a partida no banco já estavam certos o tempo todo.
      "id": "7ce188c4af9f4d8285baa22582434d6e",
      "localConnectionString": "postgres://brasilgrid:brasilgrid@localhost:5433/brasilgrid"
    }
  ],
  "vars": {
    "PUBLIC_URL": "https://brasilgrid.afasergio.workers.dev",
    // Sem domínio verificado no Resend, só dá para enviar para o e-mail do dono da conta.
    "EMAIL_FROM": "BrasilGrid <onboarding@resend.dev>"
  },
  "triggers": {
    // 03:05 UTC = 00:05 em America/Sao_Paulo (Brasil não tem mais horário de verão)
    "crons": ["5 3 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
